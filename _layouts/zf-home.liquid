---
layout: zf
---
{%- comment -%}
  The home page (About), kept simple: the intro, the news strip, what I study, and contact.
  Content comes from the front matter of _pages/about.md;
  the behaviour (the rolling word, live decision, portrait reveal, glyphs) is in assets/zf/home.js.
{%- endcomment -%}
{%- assign s = site.data.socials -%}
<!-- ===================== HERO ===================== -->
<section class="zf-row hm-hero" id="top" aria-label="Introduction">
  <div class="hm-intro b hm-rv">
    <p class="zf-meta hm-kicker">{{ page.hero.kicker }}</p>
    <h1 class="hm-lede zf-big" aria-label="{{ page.hero.lede_before }} {{ page.hero.words | join: ', ' }}{{ page.hero.lede_after }}">
      {{ page.hero.lede_before }}
      <span class="hm-roll" aria-hidden="true"
        ><span class="hm-roll-track">
          {%- for w in page.hero.words -%}
            <span>{{ w }}</span>
          {%- endfor -%}
        </span></span
      >
      {{- page.hero.lede_after }}
    </h1>
  </div>

  <figure class="hm-portrait b">
    <img class="hm-portrait-bw" src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Portrait of Zahra Falah">
    <div class="hm-cells" aria-hidden="true"></div>
    <figcaption class="zf-meta">Zahra Falah</figcaption>
  </figure>

  <div class="hm-ddm b" id="hm-ddm">
    <div class="hm-ddm-head zf-meta"><b>A decision, live</b><span id="hm-ddm-n">0 decisions</span></div>
    <div class="hm-ddm-stage">
      <span class="hm-ddm-b hm-ddm-b--up zf-meta">Left ↑</span>
      <canvas aria-label="A drift diffusion model: noisy evidence moves until it reaches the upper or lower bound." role="img"></canvas>
      <span class="hm-ddm-b hm-ddm-b--down zf-meta">Right ↓</span>
      <span class="hm-ddm-flash" id="hm-ddm-flash" aria-hidden="true"></span>
    </div>
    <p class="hm-ddm-foot zf-meta">Noisy evidence piles up until it hits a bound. <b>Move your pointer up or down</b> to push it.</p>
  </div>
</section>

<!-- ===================== TICKER ===================== -->
<div class="zf-row" aria-label="Highlights">
  <div class="hm-ticker">
    <div class="hm-ticker-track">
      {%- for k in (1..2) -%}
        <span
          class="hm-ticker-set"
          {% if k == 2 %}
            aria-hidden="true"
          {% endif %}
        >
          {%- for t in page.timeline -%}
            <a
              href="{{ t.url | relative_url }}"
              {% if k == 2 %}
                tabindex="-1"
              {% endif %}
              ><b>{{ t.tag }}</b> {{ t.title -}}</a
            ><i>✦</i>
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

<!-- ===================== WHAT I STUDY ===================== -->
<section class="zf-row" id="research" aria-labelledby="research-h">
  <div class="zf-row zf-shead">
    <p class="zf-label b">Research</p>
    <h2 class="zf-h zf-big b" id="research-h" data-split>What I study</h2>
  </div>

  {% if page.interests %}
    <div class="w-full hm-glyphs">
      {% for it in page.interests %}
        <article class="hm-glyph b hm-rv{% if it.wide %} is-wide{% endif %}" style="--c: {{ it.color }}" tabindex="0">
          <svg viewBox="0 0 48 48" aria-hidden="true">
            {%- case it.glyph -%}
              {%- when 'game' -%}
                <path d="M11 17 H37 C44 17 47 31 43 37 C40 41 35 39 32 34 H16 C13 39 8 41 5 37 C1 31 4 17 11 17 Z" pathLength="1" />
                <path d="M15 23 V31 M11 27 H19" pathLength="1" />
                <circle class="f" cx="32" cy="24" r="3" />
                <circle class="f" cx="37" cy="29" r="3" />
              {%- when 'hci' -%}
                <circle class="f" cx="15" cy="11" r="7" />
                <path d="M15 11 L15 37 L21 31 L26 41 L30 39 L25 29 L33 29 Z" pathLength="1" />
                <path d="M4 11 h4 M15 0 v4 M7 3 l3 3" pathLength="1" />
              {%- when 'vr' -%}
                <path d="M5 17 H43 V33 H30 L24 28 L18 33 H5 Z" pathLength="1" />
                <circle class="f" cx="14" cy="24" r="3.5" />
                <circle class="f" cx="34" cy="24" r="3.5" />
                <path d="M9 17 C 12 7, 36 7, 39 17" pathLength="1" />
              {%- when 'decision' -%}
                <path class="dash" d="M4 8 H44 M4 40 H44" pathLength="1" />
                <path d="M4 24 L8 21 L11 26 L15 19 L18 22 L22 14 L25 18 L29 12 L32 15 L36 8" pathLength="1" />
                <circle class="f" cx="36" cy="8" r="3.5" />
              {%- when 'embodied' -%}
                <circle class="f" cx="25" cy="8" r="4.5" />
                <path d="M24 13 L21 27 L13 41 M21 27 L30 33 L33 43 M23 17 L12 22 M23 17 L33 13 L41 16" pathLength="1" />
              {%- when 'edtech' -%}
                <path d="M6 42 H22 V26 H6 Z M22 42 H38 V26 H22 Z M14 26 H30 V10 H14 Z" pathLength="1" />
                <rect class="f" x="30" y="10" width="12" height="12" />
              {%- when 'model' -%}
                <path d="M6 4 V42 H44" pathLength="1" />
                <path d="M8 38 C 20 38, 22 10, 42 10" pathLength="1" />
                <circle class="f" cx="25" cy="24" r="3.5" />
              {%- else -%}
                <rect class="f" x="12" y="12" width="24" height="24" />
            {%- endcase -%}
          </svg>
          <h3>{{ it.title }}</h3>
          <p>{{ it.text }}</p>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

<!-- ===================== CONTACT ===================== -->
<section class="zf-row" id="contact" aria-labelledby="contact-h">
  <div class="zf-row zf-shead">
    <p class="zf-label b">Contact</p>
    <h2 class="zf-h zf-big b" id="contact-h" data-split>Let's explore together</h2>
  </div>
  <div class="w-full zf-contact b hm-rv">
    <p>
      I'm always happy to talk about serious games, experiments, embodied interaction, decision-making and learning, and about new collaborations.
    </p>
    {% if s.email -%}
      <a class="zf-mail hm-mail" href="mailto:{{ s.email }}" data-split>{{ s.email }}</a>
    {%- endif %}
    <div class="zf-contact-links">
      {% if s.linkedin_username %}
        <a class="zf-red" href="https://www.linkedin.com/in/{{ s.linkedin_username }}" target="_blank" rel="noopener">LinkedIn ↗</a>
      {% endif %}
      {% if s.github_username %}
        <a class="zf-red" href="https://github.com/{{ s.github_username }}" target="_blank" rel="noopener">GitHub ↗</a>
      {% endif %}
      <a class="zf-red" href="{{ '/assets/pdf/Zahra_Fallah_CV.pdf' | relative_url }}" target="_blank" rel="noopener">Download CV (PDF)</a>
    </div>
  </div>
</section>

<script src="{{ '/assets/zf/home.js' | relative_url }}?v={{ site.time | date: '%s' }}" defer></script>
