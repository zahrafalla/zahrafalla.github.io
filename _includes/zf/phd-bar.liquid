{%- comment -%} Sub-navigation shared by the pages of the "Papers through my eyes" project. {%- endcomment -%}
<div class="zf-row zf-phdbar">
  <a class="zf-phdbar-title b" href="{{ '/phd/' | relative_url }}">
    <small>My PhD · Project</small>
    <b>Papers through my eyes</b>
  </a>
  <nav class="zf-phdtabs b" aria-label="Project sections">
    <a
      href="{{ '/phd/' | relative_url }}"
      {% if page.phd_tab == 'library' %}
        class="is-active" aria-current="page"
      {% endif %}
      >Library</a
    >
    <a
      href="{{ '/phd/collage/' | relative_url }}"
      {% if page.phd_tab == 'collage' %}
        class="is-active" aria-current="page"
      {% endif %}
      >Paper collage</a
    >
    <a
      href="{{ '/phd/overview/' | relative_url }}"
      {% if page.phd_tab == 'overview' %}
        class="is-active" aria-current="page"
      {% endif %}
      >Overview</a
    >
  </nav>
</div>
